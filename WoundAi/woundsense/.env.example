# WoundSense PHC Server Configuration
# Copy to .env and edit for your deployment

# Security — set a strong key for production
API_KEY=

# Model paths (mounted via Docker volume)
MODEL_DIR=/app/models
UNET_MODEL_PATH=/app/models/wound_unet.onnx
TISSUE_CLASSIFIER_PATH=/app/models/tissue_classifier.pkl

# Coin calibration
COIN_DIAMETER_MM=25.0

# Redis
REDIS_URL=redis://redis:6379

# CORS — restrict to your PHC IP range in production
ALLOWED_ORIGINS=["*"]

# Inference image size (reduce to 384 for slower phones)
INFERENCE_IMG_SIZE=512
